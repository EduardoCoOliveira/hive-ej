# ─────────────────────────────────────────────
#  Hï Tech Hub — Environment Variables Template
#  Copie este arquivo para .env.local e preencha
# ─────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Hï Tech Hub"

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Google OAuth & APIs
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# ClickUp
CLICKUP_CLIENT_ID=seu-clickup-client-id
CLICKUP_CLIENT_SECRET=seu-clickup-client-secret
CLICKUP_REDIRECT_URI=http://localhost:3000/api/auth/callback/clickup

# Notion
NOTION_CLIENT_ID=seu-notion-client-id
NOTION_CLIENT_SECRET=seu-notion-client-secret
NOTION_REDIRECT_URI=http://localhost:3000/api/auth/callback/notion

# Discord
DISCORD_BOT_TOKEN=seu-discord-bot-token
DISCORD_GUILD_ID=seu-server-id

# OpenAI
OPENAI_API_KEY=sk-...

# Stripe
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PREMIUM=price_...

# Segurança
JWT_SECRET=gere-um-secret-seguro-aqui
ENCRYPTION_KEY=gere-uma-chave-de-32-bytes-aqui

# Domínio interno com acesso premium gratuito
WHITELISTED_DOMAIN=hitech.org.br
